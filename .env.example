# Example environment file. Copy to .env for local use. Never commit .env.
MATCHIQ_ENV=local
MATCHIQ_SEED=42

# Comma-separated browser origins allowed to call the API.
MATCHIQ_CORS_ORIGINS=http://localhost:5173

# --- Microsoft Foundry / Azure OpenAI (optional; offline MockLLM otherwise) ---
# MATCHIQ_AZURE_ENDPOINT=https://<resource>.openai.azure.com
# MATCHIQ_AZURE_API_KEY=<key-never-commit>
# MATCHIQ_AZURE_DEPLOYMENT=<deployment-name>
# MATCHIQ_AZURE_API_VERSION=2024-10-01-preview

# --- Azure Cosmos DB match state (optional; in-memory store otherwise) ---
# MATCHIQ_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# MATCHIQ_COSMOS_KEY=<primary-key-never-commit>
# MATCHIQ_COSMOS_DATABASE=matchiq
# MATCHIQ_COSMOS_CONTAINER=matches
# MATCHIQ_USE_MANAGED_IDENTITY=0

# --- Alternative: PostgreSQL URL behind the same store interface ---
# MATCHIQ_DATABASE_URL=postgresql://user:pass@localhost:5432/matchiq
